# Copy to .env and fill in real values before any non-local deployment.
# Never commit a real .env file — this is a template only (Part 20/36).

# Local SQLite default (zero setup). For PostgreSQL (recommended, Part 12):
# RESCUENET_DATABASE_URL=postgresql://rescuenet:rescuenet_dev_password@localhost:5432/rescuenet
RESCUENET_DATABASE_URL=sqlite:///./rescuenet.db

# MUST be a long random string in any real deployment — this default is intentionally insecure.
RESCUENET_JWT_SECRET=CHANGE_ME_INSECURE_DEV_SECRET
RESCUENET_JWT_EXPIRE_MINUTES=1440

# Optional — AIProvider falls back to the deterministic MockProvider if unset (Part 8).
# Get a key at https://console.anthropic.com/ ; costs are pay-per-token, see Anthropic's pricing page.
RESCUENET_ANTHROPIC_API_KEY=

# Comma-separated list of allowed origins for the Command Center web app in production.
RESCUENET_CORS_ALLOW_ORIGINS=*
