<?xml version="1.0" encoding="utf-8"?>
<!-- Simple "mesh network" glyph — a center hub connected to four nodes — echoing the same
     Hub icon used on the app's splash screen (ui/screens/SplashScreen.kt), sized to sit
     within adaptive icons' ~66dp safe zone on a 108dp canvas so it isn't clipped by
     launchers that mask differently (circle, squircle, rounded square, etc.). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Connecting lines, center to each of the four outer nodes -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,54 L54,32" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,54 L54,76" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,54 L32,54" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,54 L76,54" />

    <!-- Outer nodes -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,32 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,76 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,54 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M76,54 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />

    <!-- Center hub, slightly larger -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />
</vector>
